APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/telecom.db
# Optional locally; required in production. Send as Authorization: Bearer <token>.
DEMO_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TIMEOUT_SECONDS=30
# Chat safeguards; use 10 / 300 / 120 to restore the original short demo limits.
CALL_MAX_CUSTOMER_TURNS=50
CALL_SESSION_TIMEOUT_SECONDS=1800
CALL_IDLE_TIMEOUT_SECONDS=600
# JSON array; Vite's /api proxy avoids needing CORS.
CORS_ORIGINS=[]
# Serve a separately built frontend when this directory contains index.html.
STATIC_DIR=frontend/dist
